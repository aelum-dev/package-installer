# aelum-package-installer — Arch package for the Aelum package manager.
#
# Built by scripts/build-pkg.sh, which generates the source tarball from
# `git ls-files`, runs makepkg here, then signs + checksums the result into
# dist/. Published to the [aelum] repository with ../repo/publish-repo.sh —
# and listed in live-iso/packages.x86_64, so the ISO build bakes it into the
# offline mirror and fresh installs ship it preinstalled.

pkgname=aelum-package-installer
# Keep in sync with [package].version in the root Cargo.toml —
# scripts/build-pkg.sh fails the build when the two drift apart.
pkgver=0.2.3
pkgrel=1
pkgdesc='GTK4/libadwaita package manager for the Aelum desktop'
arch=('x86_64')
license=('GPL-3.0-only')
# gtk4/libadwaita are linked by the binary; pkexec (polkit) is how it
# reaches root, and the helper is a bash script.
depends=('gtk4' 'libadwaita' 'polkit' 'bash')
makedepends=('rust' 'pkgconf')
# Regenerated from the tracked tree on every build-pkg.sh run, so the hash
# changes by design.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
# One artifact: a debug subpackage of a release-profile binary has no user.
options=('!debug')

build() {
    cd "$pkgname-$pkgver"
    # Drop LTO from the C flags for this build: zstd-sys compiles its vendored
    # C library through the cc crate, and `-flto` turns those objects into LLVM
    # IR that rust-lld cannot resolve — the link then fails with
    # "undefined symbol: ZSTD_*". The Rust side has its own LTO settings;
    # nothing here wants C-LTO. (Hosts without -flto in CFLAGS are unaffected.)
    CFLAGS="${CFLAGS/-flto=auto/}"
    CFLAGS="${CFLAGS/-flto/}"
    export CFLAGS
    cargo build --release --locked
}

package() {
    # build() ran in the source directory; package() starts at $srcdir again.
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/package-installer "$pkgdir/usr/bin/package-installer"
    # pacman checks the declared `license=` against /usr/share/licenses/$pkgname,
    # so the license text ships with the package.
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # The root half: the helper pkexec authenticates, its polkit action, and
    # the fail-closed grant. The helper must be root-owned and not
    # group/world-writable — makepkg files are — or pkexec refuses it.
    install -Dm755 data/helper/aelum-package-installer-helper \
        "$pkgdir/usr/bin/aelum-package-installer-helper"
    install -Dm644 data/polkit/dev.aelum.package.manage.policy \
        "$pkgdir/usr/share/polkit-1/actions/dev.aelum.package.manage.policy"
    install -Dm644 data/polkit/aelum-package-manage.rules \
        "$pkgdir/etc/polkit-1/rules.d/aelum-package-manage.rules"
    # filesystem owns /etc/polkit-1/rules.d at 750; install -D would record
    # the created directory at 755 and pacman warns on every transaction.
    chmod 750 "$pkgdir/etc/polkit-1/rules.d"
    # Refresh the MIME/desktop databases after the package's own transactions
    # (Arch runs neither on install).
    install -Dm644 data/pacman-hook/aelum-package-installer.hook \
        "$pkgdir/etc/pacman.d/hooks/aelum-package-installer.hook"
    install -Dm644 data/mime/aelum-package-installer.xml \
        "$pkgdir/usr/share/mime/packages/aelum-package-installer.xml"
    # Desktop integration. The desktop/icon/metainfo names must equal the
    # GApplication app ID: GTK4 resolves the window icon by app ID through
    # the icon theme, and the software center matches appdata by it too.
    install -Dm644 data/aelum.packageinstaller.Packages.desktop \
        "$pkgdir/usr/share/applications/aelum.packageinstaller.Packages.desktop"
    install -Dm644 data/aelum.packageinstaller.Packages.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/aelum.packageinstaller.Packages.svg"
    install -Dm644 data/aelum.packageinstaller.Packages.metainfo.xml \
        "$pkgdir/usr/share/metainfo/aelum.packageinstaller.Packages.metainfo.xml"
}
