#!/usr/bin/env bash
# aelum-package-installer-helper — the root half of every package-manager
# operation. pkexec authenticates this program (the polkit action names it
# through its exec.path annotation); it is the only place pacman runs with
# privileges, so one action and one rule cover every verb.
#
# --noconfirm everywhere: the app's dialog owns the confirmation, and a
# conflict must exit non-zero with pacman's real output rather than wait
# for a TTY that does not exist.
# No --noprogressbar: measured against pacman 7.1, pacman draws bars and
# transaction counters only on a TTY — through this app's pipe it prints
# plain lines either way — and the flag would strip the ( i/n) counters a
# TTY run does carry. progress.rs parses both shapes.
# stdbuf -oL: with stdout a pipe, glibc buffers pacman's output in 4 KiB
# blocks, and a download's lines stay in that buffer until it ends — the
# app watched "Retrieving packages..." for a minute with 700 MiB moving.
# Line-buffered, every line reaches the app as pacman prints it.
set -euo pipefail

cmd="${1:-}"
shift || true

# pacman's DB lock is an empty file it opens with O_EXCL — measured on pacman
# 7.1: mode 0000, zero bytes, no PID written — and alpm has no dead-lock
# check at all. A lock left by a killed or crashed pacman therefore answers
# every later transaction "unable to lock database", whatever verb it asked
# for, forever. So every verb below clears one first — but only with no live
# pacman anywhere: the app runs one transaction at a time, so a lock nothing
# is holding is nobody's, while a live one is a transaction that must not be
# run twice at once and is left for pacman to refuse honestly.
DB_LOCK=/var/lib/pacman/db.lck

pacman_running() {
    local comm name
    for comm in /proc/[0-9]*/comm; do
        # 2>/dev/null first: a process that exits mid-scan fails the
        # redirect, and bash would print that into the app's log.
        read -r name 2>/dev/null <"$comm" || continue
        [[ "$name" == pacman ]] && return 0
    done
    return 1
}

clear_stale_lock() {
    [[ -e "$DB_LOCK" ]] || return 0
    if pacman_running; then
        echo ":: another pacman is running — leaving its database lock"
        return 0
    fi
    echo ":: removing stale database lock: $DB_LOCK"
    rm -f -- "$DB_LOCK"
}

# The verbs are named here before anything is touched, so an unknown one is
# refused instead of clearing a lock on a call that runs no pacman at all.
# The dispatch below is exhaustive for them.
case "$cmd" in
    refresh|install|install-asdeps|remove|upgrade|file|file-asdeps) clear_stale_lock ;;
    *)
        echo "usage: aelum-package-installer-helper {refresh|install|install-asdeps|remove|upgrade|file|file-asdeps} [args...]" >&2
        exit 2
        ;;
esac

case "$cmd" in
    refresh) exec stdbuf -oL pacman -Sy --noconfirm "$@" ;;
    install) exec stdbuf -oL pacman -S --needed --noconfirm -- "$@" ;;
    # the asdeps verbs carry the marking makepkg's -s uses: what the AUR
    # flow brings that the user did not name is a dependency, never an
    # Explicit package that outlives every -Rns and reads as installed.
    install-asdeps) exec stdbuf -oL pacman -S --needed --asdeps --noconfirm -- "$@" ;;
    remove)  exec stdbuf -oL pacman -Rns --noconfirm -- "$@" ;;
    upgrade) exec stdbuf -oL pacman -Syu --noconfirm ;;
    file)    exec stdbuf -oL pacman -U --noconfirm -- "$@" ;;
    file-asdeps) exec stdbuf -oL pacman -U --asdeps --noconfirm -- "$@" ;;
esac
