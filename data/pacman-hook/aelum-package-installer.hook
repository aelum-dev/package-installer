# Arch runs neither update-mime-database nor update-desktop-database when a
# package installs, and this package is the first handler of its own MIME
# type — so it refreshes both databases itself, after its own transactions.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = aelum-package-installer

[Action]
Description = Updating MIME and desktop databases for the package manager…
When = PostTransaction
Exec = /usr/bin/sh -c "update-mime-database /usr/share/mime && update-desktop-database -q /usr/share/applications"
# One dependency per line — the hook parser does not split one value on
# spaces (measured: a single `Depends = a b` line never satisfies), and
# every system hook repeats the key.
Depends = shared-mime-info
Depends = desktop-file-utils
