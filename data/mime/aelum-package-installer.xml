<?xml version="1.0" encoding="UTF-8"?>
<!-- The type for Arch package files. The globs beat shared-mime-info's
     archive magic for *.pkg.tar.zst (globs outrank magic), so a package
     file resolves to this type and the package manager is its only
     handler — the default then resolves to the manager with no per-user
     config, which is what covers systems that install the app later.

     Two things stay out of this file on purpose. No *.pkg.tar glob: an
     uncompressed package file is almost always the leftover an archive
     manager makes when it peels the zstd layer off a *.pkg.tar.zst
     (file-roller's magic-only fallback sees 28 B5 2F FD and answers
     application/zstd), and claiming it too would box-icon that leftover
     and offer it back as a package; as the plain tar it is, it opens and
     extracts normally. The app still reads one handed to it directly —
     read_pkginfo sniffs the framing instead of believing the name.
     And no <parent> archive supertype: it would list the archive manager
     as a second handler, and the sole-handler fallback above — the
     double-click story — is what having exactly one buys. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.arch.pacman">
    <comment>Arch Linux package</comment>
    <glob pattern="*.pkg.tar.zst"/>
    <glob pattern="*.pkg.tar.xz"/>
    <glob pattern="*.pkg.tar.gz"/>
  </mime-type>
</mime-info>
