<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://specifications.freedesktop.org/PolicyKit/1.0/policyconfig.dtd">
<!--
  SPDX-License-Identifier: GPL-3.0

  The action every package-manager operation runs through: refresh, install,
  remove, upgrade, and local files are one action because the dialog shows
  the real transaction; the auth prompt only needs to name the program.

  The defaults refuse it everywhere — the grant is /etc/polkit-1/rules.d's
  job — so a missing or broken rules file fails closed. The exec.path
  annotation is what makes `pkexec <helper>` resolve to this action: the
  app names the program, never the action, and pkexec authenticates the
  program (root-owned, not group/world-writable) before it asks polkit
  anything at all. Same shape as dev.aelum.snapshot.restore.
-->
<policyconfig>
  <vendor>Aelum</vendor>
  <vendor_url>https://aelum.dev</vendor_url>

  <action id="dev.aelum.package.manage">
    <description>Install or remove software</description>
    <message>Package operations change the installed system and run as root.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/aelum-package-installer-helper</annotate>
  </action>
</policyconfig>
