[Desktop Entry]
Type=Application
# The unlocalized Name is the en-US string.
Name=Packages
# Name[] follows the video-player's rules: POSIX locale codes (GLib tries
# LC_MESSAGES-shaped keys, never BCP-47), language-only where one form
# serves the whole language, territory only for zh. Wording: the msgid
# "Packages" as the system's own catalogs carry it (gnome-packagekit,
# rpm, dnf's desktop files); where a language has no shipped precedent,
# the plain plural of that language's word for a software package.
Name[ar]=الحزم
Name[bg]=Пакети
Name[ca]=Paquets
Name[de]=Pakete
Name[el]=Πακέτα
Name[eo]=Pakaĵoj
Name[es]=Paquetes
Name[fa]=بسته‌ها
Name[fi]=Paketit
Name[fr]=Paquets
Name[he]=חבילות
Name[hu]=Csomagok
Name[id]=Paket
Name[it]=Pacchetti
Name[ja]=パッケージ
Name[ko]=패키지
Name[nb]=Pakker
Name[nl]=Pakketten
Name[pl]=Pakiety
Name[pt]=Pacotes
Name[ru]=Пакеты
Name[sv]=Paket
Name[tr]=Paketler
Name[uk]=Пакети
Name[vi]=Gói
Name[zh]=软件包
Name[zh_CN]=软件包
Name[zh_TW]=軟體包
GenericName=Package manager
Comment=Install and remove software
# The app opens its Installed page with no arguments; %U is for the
# file-open flow (the custom MIME type below).
Exec=package-installer %U
TryExec=package-installer
Icon=aelum.packageinstaller.Packages
Terminal=false
Categories=System;
Keywords=package;install;remove;update;pacman;software;
# Concrete types only (the spec rejects wildcards). The custom type plus
# the globs in the package's shared-mime-info XML is what makes a double-
# clicked .pkg.tar.zst open here; this app is the only handler declared.
MimeType=application/vnd.arch.pacman;
# The WM class IS the app ID under GTK4/Wayland; StartupWMClass keeps the
# launcher's startup notification matched to the window.
StartupNotify=true
StartupWMClass=aelum.packageinstaller.Packages
