[Desktop Entry]
Type=Application
# The unlocalized Name is the en-US string.
Name=Packages
# Name[] follows the video-player's rules: POSIX locale codes (GLib tries
# LC_MESSAGES-shaped keys, never BCP-47), language-only where one form
# serves the whole language, territory only for zh. Wording: the msgid
# "Packages" as the system's own catalogs carry it (gnome-packagekit,
# rpm, dnf's desktop files); where a language has no shipped precedent,
# the plain plural of that language's word for a software package.
